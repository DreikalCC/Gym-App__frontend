# Optional for local frontend development when the API runs on another origin.
# Leave unset on Netlify because the frontend and API use the same /api origin.
REACT_APP_API_URL=http://localhost:8888/api

# Server-only values used by Netlify Functions. Never prefix these with REACT_APP_.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/gym-app
JWT_SECRET=replace-with-a-long-random-secret

